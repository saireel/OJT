{
  "name": "copilot-bridge",
  "displayName": "Copilot Bridge",
  "description": "Local REST API bridge to GitHub Copilot",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilotBridge.start",
        "title": "Copilot Bridge: Start Server"
      },
      {
        "command": "copilotBridge.stop",
        "title": "Copilot Bridge: Stop Server"
      }
    ],
    "configuration": {
      "title": "Copilot Bridge",
      "properties": {
        "copilotBridge.fastModelHints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "claude",
            "haiku",
            "sonnet"
          ],
          "description": "Model name/family hints used for fast tasks. The extension picks the first available model matching these hints."
        },
        "copilotBridge.defaultModelHints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "claude",
            "sonnet",
            "opus"
          ],
          "description": "Model name/family hints used for non-fast tasks. The extension picks the first available model matching these hints."
        }
      }
    }
  },
  "extensionDependencies": [
    "github.copilot-chat"
  ]
}
